<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- ADB Daemon Status -->
                <LinearLayout
                    android:id="@+id/layoutAdbStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <View
                        android:id="@+id/indicatorAdb"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/floating_btn_bg"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvAdbStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/adb_status_inactive"
                        android:textColor="@color/accent_orange"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Overlay Permission -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/overlay_permission"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>

                <!-- Accessibility Permission (Fallback) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/accessibility_permission"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAdbGuide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_activate_guide"
                    android:textColor="@color/primary"
                    android:backgroundTint="@color/surface_dark"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Advanced Gaming Features Card (Anti-Cheat & Recoil & Macro) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tính Năng Nâng Cao &amp; Chống Quét AI"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Humanize Touch Anti-Cheat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Humanize Touch (Cảm ứng Sinh học)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tự động tạo rung ngón tay vi mô &amp; đường cong Bezier chống AI quét"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchHumanize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- Gyroscope Simulation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mô Phỏng Con Quay Hồi Chuyển (Gyroscope)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dịch chuyển động vi mô của chuột thành cảm ứng Gyro ghìm tâm"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchGyro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- Auto-Profile Switching Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tự Động Đổi Hồ Sơ Theo Game"
                            android:textColor="@color/accent_green"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tự nhận diện khi mở Free Fire, PUBG, Liên Quân, COD..."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- Local JSON Backup & Restore Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnExportJson"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="📥 Xuất File .JSON"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:background="@drawable/card_neon_border"
                        app:backgroundTint="@color/surface_dark"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnImportJson"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="📤 Nhập File .JSON"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp"
                        android:background="@drawable/card_neon_border"
                        app:backgroundTint="@color/surface_dark" />
                </LinearLayout>

                <!-- Auto Recoil Compensation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hỗ Trợ Ghìm Tâm (Auto Recoil)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tự động kéo tâm súng xuống nhẹ nhàng khi giữ chuột trái sấy đạn"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRecoil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- Visual Detection & Auto-Trigger (Image/Color Recognition) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhận Diện Hình Ảnh / Màu Sắc (Visual AI)"
                                android:textColor="@color/accent_orange"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tự động bấm hoặc kéo tâm khi phát hiện mục tiêu trên màn hình"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchVision"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Vision Mode RadioGroup -->
                    <RadioGroup
                        android:id="@+id/rgVisionMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <RadioButton
                            android:id="@+id/rbAutoTap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bấm Trực Tiếp Vào Điểm Phát Hiện (Auto-Tap on Target)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbAutoFire"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tự Động Bắn Khi Mục Tiêu Vào Tâm (Auto Trigger Fire)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbAimAssist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hỗ Trợ Kéo Tâm Về Mục Tiêu (Visual Aim Assist)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Hotkey Quick Guide -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phím Nóng (Tương thích bàn phím 1 tay F1-F6, 1-6, Q-T, A-G, Z-B):"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_dark"
                    android:padding="8dp"
                    android:text="• Ctrl hoặc ~ : Khóa / Mở con trỏ chuột FPS\n• F4 hoặc Ctrl + B : Ẩn / Hiện toàn bộ giao diện (Tàng hình)\n• F5 : Bật / Tắt Ghi Macro thao tác (Record)\n• F6 : Bật / Tắt Chạy Macro Lặp Vô Hạn"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Target Games Selection Card (Auto-Show only in Game) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 Chọn Game Kích Hoạt (Chỉ Hiện Khi Vào Game)"
                    android:textColor="@color/accent_green"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keymap sẽ tự động ẨN HOÀN TOÀN khi ra màn hình chính, chỉ hiện khi bạn mở các game bên dưới:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <CheckBox
                    android:id="@+id/cbFreeFire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Free Fire / Free Fire MAX"
                    android:textColor="@color/text_primary"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cbPubg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PUBG Mobile (VNG / Quốc Tế)"
                    android:textColor="@color/text_primary"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cbLienQuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Liên Quân Mobile / LMHT Tốc Chiến"
                    android:textColor="@color/text_primary"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cbCod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Call of Duty Mobile"
                    android:textColor="@color/text_primary"
                    android:checked="true" />

                <Button
                    android:id="@+id/btnAddCustomGame"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="➕ Thêm Game Khác Từ Máy"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:background="@drawable/card_neon_border"
                    app:backgroundTint="@color/surface_dark"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Profile Selection Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgProfiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbFps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_fps_default"
                        android:textColor="@color/text_primary"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbMoba"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_moba_default"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/rbCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_custom"
                        android:textColor="@color/text_primary" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sensitivity & Display Scale Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tốc Độ Chuột &amp; Tùy Chỉnh Hiển Thị (Full-View)"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Global Mouse Speed -->
                <TextView
                    android:id="@+id/tvGlobalSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tốc độ chuột tổng thể: 100%"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbGlobalSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200"
                    android:progress="100"
                    android:thumbTint="@color/primary"
                    android:progressTint="@color/primary"
                    android:layout_marginBottom="10dp" />

                <!-- Button Scale (Size) -->
                <TextView
                    android:id="@+id/tvButtonScale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kích thước nút bấm &amp; Icon: 100%"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbButtonScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="150"
                    android:progress="50"
                    android:thumbTint="@color/accent_green"
                    android:progressTint="@color/accent_green"
                    android:layout_marginBottom="10dp" />

                <!-- Button Opacity (Transparency) -->
                <TextView
                    android:id="@+id/tvButtonOpacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Độ mờ / Độ trong suốt nút (Full-View): 45%"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbButtonOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="45"
                    android:thumbTint="@color/accent_purple"
                    android:progressTint="@color/accent_purple"
                    android:layout_marginBottom="10dp" />

                <!-- X Sensitivity -->
                <TextView
                    android:id="@+id/tvSensX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Độ nhạy trục ngang (X): 50%"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbSensX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:thumbTint="@color/primary"
                    android:progressTint="@color/primary"
                    android:layout_marginBottom="8dp" />

                <!-- Y Sensitivity -->
                <TextView
                    android:id="@+id/tvSensY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Độ nhạy trục dọc (Y): 50%"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbSensY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:thumbTint="@color/secondary"
                    android:progressTint="@color/secondary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Main Action Button -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_start_service"
            android:textColor="@color/background_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_neon_primary"
            app:backgroundTint="@null"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
