<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_neon_border"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chào Mừng Đến Với Tx"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permission_desc"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Permission 1: Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_dark"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_overlay_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_overlay_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_grant"
            android:textColor="@color/background_dark"
            android:textSize="11sp"
            android:background="@drawable/btn_neon_primary"
            app:backgroundTint="@null"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Permission 2: Accessibility -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_dark"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_accessibility_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_accessibility_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGrantAccessibility"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_grant"
            android:textColor="@color/background_dark"
            android:textSize="11sp"
            android:background="@drawable/btn_neon_primary"
            app:backgroundTint="@null"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Permission 3: Notification -->
    <LinearLayout
        android:id="@+id/layoutNotificationPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_dark"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_notification_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_notification_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGrantNotification"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_grant"
            android:textColor="@color/background_dark"
            android:textSize="11sp"
            android:background="@drawable/btn_neon_primary"
            app:backgroundTint="@null"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Done Button -->
    <Button
        android:id="@+id/btnDonePermissions"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Bắt Đầu Trải Nghiệm Tx"
        android:textColor="@color/background_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/btn_neon_primary"
        app:backgroundTint="@null" />

</LinearLayout>
